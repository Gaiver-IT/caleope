#!/bin/sh
# Active le thème Plymouth Caleope et le grave dans l'initramfs (boot graphique).
set -e

if command -v plymouth-set-default-theme >/dev/null 2>&1; then
    plymouth-set-default-theme -R caleope || {
        plymouth-set-default-theme caleope || true
        update-initramfs -u || true
    }
fi
