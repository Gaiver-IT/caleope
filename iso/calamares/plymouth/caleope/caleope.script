# Écran de démarrage Caleope — logo centré pulsant sur fond sombre + messages discrets.
# (Plymouth script module — remplace le défilement de texte du boot.)

Window.SetBackgroundTopColor(0.047, 0.047, 0.055);     # #0c0c0e
Window.SetBackgroundBottomColor(0.020, 0.020, 0.031);  # #05050a

# ── Logo centré ──
logo.image  = Image("logo.png");
logo.sprite = Sprite(logo.image);
logo.x = Window.GetWidth()  / 2 - logo.image.GetWidth()  / 2;
logo.y = Window.GetHeight() / 2 - logo.image.GetHeight() / 2 - 30;
logo.sprite.SetX(logo.x);
logo.sprite.SetY(logo.y);
logo.sprite.SetZ(10);

# ── Wordmark ──
wm.image  = Image.Text("CALEOPE", 0.90, 0.86, 1.0, 1, "DejaVu Sans 20");
wm.sprite = Sprite(wm.image);
wm.sprite.SetX(Window.GetWidth() / 2 - wm.image.GetWidth() / 2);
wm.sprite.SetY(logo.y + logo.image.GetHeight() + 22);

# ── Pulsation douce du logo ──
tick = 0;
fun refresh() {
    tick++;
    o = 0.75 + 0.25 * Math.Sin(tick / 18);
    logo.sprite.SetOpacity(o);
}
Plymouth.SetRefreshFunction(refresh);

# ── Messages système (bas, discrets) ──
msg.sprite = Sprite();
fun message(text) {
    msg.image = Image.Text(text, 0.42, 0.40, 0.50, 1, "DejaVu Sans 10");
    msg.sprite.SetImage(msg.image);
    msg.sprite.SetX(Window.GetWidth() / 2 - msg.image.GetWidth() / 2);
    msg.sprite.SetY(Window.GetHeight() - 56);
}
Plymouth.SetMessageFunction(message);

# ── Invite mot de passe (LUKS éventuel) ──
fun display_password(prompt, bullets) { message(prompt); }
Plymouth.SetDisplayPasswordFunction(display_password);
